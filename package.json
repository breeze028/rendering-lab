{
  "name": "rendering-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "preview": "astro preview --host 127.0.0.1",
    "typecheck": "astro check",
    "build": "node scripts/prepare-runtime.mjs && astro build",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write src scripts tests *.mjs *.ts .github .prettierrc.json package.json tsconfig.json",
    "format:check": "prettier --check src scripts tests *.mjs *.ts .github .prettierrc.json package.json tsconfig.json"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.0",
    "@astrojs/react": "^4.4.0",
    "astro": "^5.16.0",
    "katex": "^0.16.25",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@webgpu/types": "0.1.69",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^5.9.3"
  }
}
