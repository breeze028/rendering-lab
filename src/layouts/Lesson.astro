---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
const {
  title = '多重重要性采样',
  description = '从数学、交互实验与真实计算中理解光传输。',
  section = '05',
  toc = [],
} = Astro.props.frontmatter ?? Astro.props;
const base = import.meta.env.BASE_URL;
const modules = [
  '几何与光线追踪',
  '辐射度量学',
  '反射模型与 BSDF',
  '蒙特卡洛积分',
  '重要性采样',
  '路径追踪',
  '双向路径追踪',
  '光子映射 / SPPM',
  'Metropolis 光传输',
  '高级材质',
  '体积渲染',
  '图像重建与降噪',
  '可微渲染',
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} — Rendering Lab</title>
    <link rel="icon" href={`${base}favicon.svg`} />
  </head>
  <body>
    <a class="skip-link" href="#content">
      跳转到正文
    </a>
    <header class="site-header">
      <a class="brand" href={base}>
        <svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true">
          <path
            d="M13 2 24 8.5v9L13 24 2 17.5v-9L13 2Z M2 8.5l11 6.5 11-6.5M13 15v9M13 2v13"
            stroke="currentColor"
            stroke-width="1.3"
          />
        </svg>
        Rendering <span>Lab</span>
      </a>
      <nav aria-label="Main navigation">
        <a class="active" href={base}>
          教程
        </a>
        <a href={`${base}lab/`}>
          Lab <span>↗</span>
        </a>
        <a href={`${base}roadmap/`}>学习路线</a>
      </nav>
      <a class="source-link" href="https://github.com/breeze028/rendering-lab">
        源码 <span>↗</span>
      </a>
    </header>
    <div class="page-grid">
      <aside class="course-sidebar">
        <details open>
          <summary>
            光传输 <span>⌄</span>
          </summary>
          <p class="sidebar-intro">从一条光线到一幅图像。</p>
          <nav aria-label="Course navigation">
            {modules.map((m, i) => (
              <div class:list={['course-module', { current: i === 4 }]}>
                {i === 3 ? (
                  <a class="module-title" href={`${base}learn/monte-carlo/`}>
                    <span>{String(i + 1).padStart(2, '0')}</span>
                    {m}
                  </a>
                ) : (
                  <div class="module-title">
                    <span>{String(i + 1).padStart(2, '0')}</span>
                    {m}
                    {![3, 4].includes(i) && <small>规划中</small>}
                  </div>
                )}
                {i === 4 && (
                  <div class="sublessons">
                    <a href={`${base}learn/next-event-estimation/`}>下一事件估计</a>
                    <a class:list={{ selected: section === '05' }} href={base}>
                      多重重要性采样
                    </a>
                    <a href={`${base}#renderer`}>
                      Cornell Box 实验 <span>↗</span>
                    </a>
                  </div>
                )}
              </div>
            ))}
          </nav>
        </details>
        <div class="sidebar-bottom">
          <i class="status-dot" />
          开放源码，自由探索。<a href={`${base}roadmap/`}>关于本站 ↗</a>
        </div>
      </aside>
      <main id="content">
        <div class="breadcrumb">
          光传输 <span>/</span> {section === '04' ? '蒙特卡洛积分' : '重要性采样'}
        </div>
        <slot />
        <footer class="lesson-footer">
          <span>Rendering Lab · 让计算过程变得清晰。</span>
          <a href="https://github.com/breeze028/rendering-lab">查看源码 ↗</a>
        </footer>
      </main>
      <aside class="toc">
        <div class="eyebrow">本页目录</div>
        <nav aria-label="Table of contents">
          {toc.map((item: { id: string; label: string }, i: number) => (
            <a href={`#${item.id}`}>
              <span>{String(i + 1).padStart(2, '0')}</span>
              {item.label}
            </a>
          ))}
        </nav>
        <div class="toc-note">
          理解原理。
          <br />
          调整参数。
          <br />
          跟踪计算。
        </div>
        <a class="toc-lab" href={`${base}#renderer`}>
          打开实验 <span>↗</span>
        </a>
      </aside>
    </div>
    <script is:inline>
      if (innerWidth <= 800)
        document.querySelector('.course-sidebar details')?.removeAttribute('open');
    </script>
  </body>
</html>
