---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
const {title='Multiple Importance Sampling',description='Learn light transport by following the computation.',section='05',toc=[]}=Astro.props.frontmatter??Astro.props;
const base=import.meta.env.BASE_URL;
const modules=['Geometry & Ray Tracing','Radiometry','Reflection & BSDF','Monte Carlo Integration','Importance Sampling','Path Tracing','Bidirectional Path Tracing','Photon Mapping / SPPM','Metropolis Light Transport','Advanced Materials','Volumetric Rendering','Reconstruction & Denoising','Differentiable Rendering'];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><title>{title} — Rendering Lab</title><link rel="icon" href={`${base}favicon.svg`}/></head><body>
<a class="skip-link" href="#content">Skip to content</a>
<header class="site-header"><a class="brand" href={base}><svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true"><path d="M13 2 24 8.5v9L13 24 2 17.5v-9L13 2Z M2 8.5l11 6.5 11-6.5M13 15v9M13 2v13" stroke="currentColor" stroke-width="1.3"/></svg>Rendering <span>Lab</span></a><nav aria-label="Main navigation"><a class="active" href={base}>Learn</a><a href={`${base}lab/`}>Lab <span>↗</span></a><a href={`${base}roadmap/`}>Roadmap</a></nav><a class="source-link" href="https://github.com/breeze028/rendering-lab">Source <span>↗</span></a></header>
<div class="page-grid"><aside class="course-sidebar"><details open><summary>LIGHT TRANSPORT <span>⌄</span></summary><p class="sidebar-intro">From a ray to an image.</p><nav aria-label="Course navigation">{modules.map((m,i)=><div class:list={['course-module',{'current':i===4}]}>{i===3?<a class="module-title" href={`${base}learn/monte-carlo/`}><span>{String(i+1).padStart(2,'0')}</span>{m}</a>:<div class="module-title"><span>{String(i+1).padStart(2,'0')}</span>{m}{![3,4].includes(i)&&<small>planned</small>}</div>}{i===4&&<div class="sublessons"><a href={`${base}learn/next-event-estimation/`}>Next event estimation</a><a class:list={{selected:section==='05'}} href={base}>Multiple importance sampling</a><a href={`${base}#renderer`}>Cornell Box experiment <span>↗</span></a></div>}</div>)}</nav></details><div class="sidebar-bottom"><i class="status-dot"/>Open source. Open exploration.<a href={`${base}roadmap/`}>About this lab ↗</a></div></aside>
<main id="content"><div class="breadcrumb">Light transport <span>/</span> {section==='04'?'Monte Carlo integration':'Importance sampling'}</div><slot/><footer class="lesson-footer"><span>Rendering Lab · Built to be understood.</span><a href="https://github.com/breeze028/rendering-lab">Inspect the source ↗</a></footer></main>
<aside class="toc"><div class="eyebrow">ON THIS PAGE</div><nav aria-label="Table of contents">{toc.map((item:{id:string;label:string},i:number)=><a href={`#${item.id}`}><span>{String(i+1).padStart(2,'0')}</span>{item.label}</a>)}</nav><div class="toc-note">Read the idea.<br/>Change a parameter.<br/>Follow the computation.</div><a class="toc-lab" href={`${base}#renderer`}>Open the experiment <span>↗</span></a></aside></div>
<script is:inline>if(innerWidth<=800)document.querySelector('.course-sidebar details')?.removeAttribute('open');</script>
</body></html>
